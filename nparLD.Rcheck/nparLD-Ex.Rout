> # Dunnett-type contrasts for the levels of time2
> fit <- nparLD(resp ~ time1 * time2,
+               data = amylase,
+               subject = "subject",
+               hypothesis = "H0p",
+               contrast = list("time2", "Dunnett"),
+               Factor.Information = TRUE)
> fit

